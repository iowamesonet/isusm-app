require "base64"

default_platform(:ios)

platform :ios do
  desc "Build and upload a new build to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true
    )

    # Sanity-check the key via fastlane's own (spaceship) ASC client, which is
    # independent of xcodebuild's built-in -authenticationKeyPath auth. If this
    # fails too, the ASC_KEY_ID/ASC_ISSUER_ID/ASC_KEY_CONTENT secrets themselves
    # are the problem, not the xcodebuild provisioning-update flow.
    build_number = latest_testflight_build_number(api_key: api_key)
    UI.success("ASC API key check passed (latest TestFlight build: #{build_number})")

    # xcodebuild does not read the api key from the fastlane lane context, it
    # needs the key file path plus id/issuer passed explicitly for -allowProvisioningUpdates.
    # xcodebuild expects the filename itself to encode the key id (AuthKey_<KEY_ID>.p8),
    # otherwise it can silently fail to authenticate against Apple (401 on listTeams.action).
    auth_key_path = File.expand_path("AuthKey_#{ENV["ASC_KEY_ID"]}.p8")
    File.write(auth_key_path, Base64.decode64(ENV["ASC_KEY_CONTENT"]))

    begin
      build_app(
        workspace: "Runner.xcworkspace",
        scheme: "Runner",
        export_method: "app-store",
        xcargs: "-allowProvisioningUpdates " \
                "-authenticationKeyPath #{auth_key_path} " \
                "-authenticationKeyID #{ENV["ASC_KEY_ID"]} " \
                "-authenticationKeyIssuerID #{ENV["ASC_ISSUER_ID"]} " \
                "FLUTTER_BUILD_NUMBER=#{ENV["GITHUB_RUN_NUMBER"]} " \
                "DEVELOPMENT_TEAM=#{ENV["APPLE_TEAM_ID"]} CODE_SIGN_STYLE=Automatic " \
                # project.pbxproj hardcodes CODE_SIGN_IDENTITY to "iPhone Developer" for
                # Release/Profile, which makes automatic signing request a Development
                # profile instead of Distribution; force the correct identity here.
                "\"CODE_SIGN_IDENTITY[sdk=iphoneos*]=Apple Distribution\""
      )
    ensure
      File.delete(auth_key_path) if File.exist?(auth_key_path)
    end

    upload_to_testflight(api_key: api_key)
  end
end
